# ============================================================
# BELLO HABITAT CONSULTANCY & VASTUKALA - NODEMAILER SETTINGS
# ============================================================

# Recipient email where all consultation inquiries will be delivered
MAIL_TO=himanshu@bellohc.com

# Sender display name & address
MAIL_FROM="Bello Habitat Consultations" <himanshu@bellohc.com>

# Whether to send an automatic confirmation copy to the client's email
SEND_CLIENT_CONFIRMATION=true

# ------------------------------------------------------------
# SMTP CREDENTIALS
# Fill in your SMTP details below to enable live email delivery.
# If left blank, the service operates in dev simulation mode and
# logs all inquiry details cleanly to the console.
# ------------------------------------------------------------

# --- Option 1: Titan Mail / Hostinger (e.g. himanshu@bellohc.com) ---
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=himanshu@bellohc.com
# SMTP_PASS=your_email_password_here

# --- Option 2: Google Workspace / Gmail (requires App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password

# --- Option 3: Custom Domain cPanel / Webmail ---
# SMTP_HOST=mail.bellohc.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=himanshu@bellohc.com
# SMTP_PASS=your_password_here

# Standalone Express server port
PORT=5000

